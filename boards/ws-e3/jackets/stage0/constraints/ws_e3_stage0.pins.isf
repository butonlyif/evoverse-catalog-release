design.set_device_property("TR1","VOLTAGE","3.3","IOBANK")
# §15 bootstrap: create_* is a one-shot ritual for a peri.xml-less project.
# Unified Flow auto-infers these plain RTL-port GPIOs at map stage, so the
# create_* lines MUST stay commented for replay builds (otherwise
# "GPIO xxx exists"). Enable ONLY when bootstrapping without peri.xml.
# design.create_input_clock_gpio("clk_50m")
# Board osc ball R3 is PLL_CLKIN-only (GPIOB_P_03_PLLIN0, 100 MHz HCSL osc
# Y3); stage0 uses the clock directly (no PLL), so route via a GCLK-capable
# ball instead: M4 = GPIOB_P_15_CDI17_CLK2_P (bank 4D, 1.8 V, carrier spare).
design.assign_pkg_pin("clk_50m","M4")
design.set_property("clk_50m","IO_STANDARD","1.8 V LVCMOS","GPIO")
# design.create_input_gpio("arst_n")
design.assign_pkg_pin("arst_n","A3")
design.set_property("arst_n","IO_STANDARD","1.8 V LVCMOS","GPIO")
# design.create_output_gpio("led_user")
design.assign_pkg_pin("led_user","C1")
design.set_property("led_user","IO_STANDARD","1.8 V LVCMOS","GPIO")
