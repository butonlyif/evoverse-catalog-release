######################################################################################################
ifeq ($(CM4),yes)
CFILES = \
	 portable/RVDS/ARM_CM4F/port.c

TARGET_SEL = --cpu=Cortex-M4
TGTFLAGS = $(TARGET_SEL) --fpu=vfp \
	-Iportable/RVDS/ARM_CM4F
endif

ifeq ($(CM0),yes)
CFILES = \
	 portable/RVDS/ARM_CM0/port.c

TARGET_SEL = --cpu=Cortex-M0plus
TGTFLAGS =  $(TARGET_SEL) \
	-Iportable/RVDS/ARM_CM0
endif
######################################################################################################

# C source files
CFILES += \
	portable/MemMang/heap_4.c  \
	croutine.c \
	event_groups.c \
	list.c \
	queue.c \
	stream_buffer.c \
	tasks.c \
	timers.c

# Compiler command line arguments.
CFLAGS              = \
	-O3 $(TGTFLAGS) \
	-I. \
	-ICore/Include \
	-Iinclude \
	-I../fx3g2_utils \
	--diag_suppress=L6471E,9931,9933 -g --c99 --output_dir=out \
	-DCYUSB4024_BZXI \
	-DFREERTOS_ENABLE=$(RTOS_EN) -DDEBUG_INFRA_EN=1

CFLAGS += -DBCLK__BUS_CLK__HZ=75000000

OBJECTS =		\
	out/port.o \
	out/heap_4.o \
	out/croutine.o \
	out/event_groups.o \
	out/list.o \
	out/queue.o \
	out/stream_buffer.o \
	out/tasks.o \
	out/timers.o

# Path to compiler/linker tools.
CC                  = armcc


DONE=@if [ -f $(1) ]; then echo Build completed.; fi
RM=rm -f $(1)

.SUFFIXES: .o .c .s
.PHONY: all clean build

all: clean ofiles

rebuild: all

clean:
	rm -rf out
	mkdir out

ofiles : $(CFILES)
	 @echo "-------------------"
	 @echo "Building the FreeRTOS C files"
	 @echo "-------------------"
	 for f in $(CFILES); do \
	     echo "Compiling $$f"; \
	     $(CC) $(CFLAGS) -c $$f ; \
	 done
	 @echo "----------------------"
	 @echo "Done compiling FreeRTOS C files"
	 @echo "----------------------"
